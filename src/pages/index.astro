---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import Gallery from "../components/Gallery.astro";
import Contact from "../components/Contact.astro";
import Map from "../components/Map.astro";
import { sitio, pilares, paisesPlanificados } from "../data/site";
import { entorno } from "../server/env";
import { viajesPublicos, fotosPublicas, ciudadPublica } from "../server/data";
const [viajes, fotos, ciudad] = await Promise.all([
  viajesPublicos(entorno),
  fotosPublicas(entorno),
  ciudadPublica(entorno),
]);
---

<Layout portada>
  <section id="main-header" class="hero">
    <img
      class="hero-image"
      src="/img/cicloturismo-portada-1080.jpg"
      alt="Una bicicleta lista para descubrir un camino entre árboles"
      width="1080"
      height="720"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <span class="eyebrow">CICLOTURISMO · LIBERTAD · ENCUENTROS</span>
      <h1>
        Experimenta
        <br />
        <em>la libertad.</em>
      </h1>
      <p>
        Atrévete y sal de la rutina.
        <br />
        Hay un mundo esperando al otro lado del primer pedalazo.
      </p>
      <a class="btn btn-yellow" href="#rutas">
        Descubre el viaje <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="wrap hero-bottom">
      <span>VIAJAR LIGERO. VIVIR EL CAMINO.</span>
      <a href="#quienes" aria-label="Conocer el proyecto">
        ↓
      </a>
    </div>
    <div class="hero-seal">
      <Logo />
      <span>IREMOS, A NUESTRO RITMO.</span>
    </div>
  </section>
  <section class="ciudad-strip" aria-label="Última ciudad compartida">
    <div class="wrap ciudad-inner">
      <span class="location-dot" aria-hidden="true"></span>
      <div>
        <span class="eyebrow">ÚLTIMA CIUDAD COMPARTIDA</span>
        <p>
          {ciudad
            ? `${ciudad.ciudad}, ${ciudad.pais}`
            : "El próximo capítulo está por comenzar."}
        </p>
      </div>
      <p class="ciudad-note">
        {ciudad
          ? `Publicada el ${new Intl.DateTimeFormat("es", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(ciudad.fecha_publicacion + "T12:00:00Z"))}. Ubicación aproximada.`
          : "Compartiré una ciudad cuando sea el momento."}
      </p>
    </div>
  </section>
  <section id="quienes" class="section">
    <div class="wrap proyecto-grid">
      <div class="proyecto-imagen">
        <img
          src="/img-perfiles/imagen-somos-jose-reina.png"
          alt="José Reina, fundador de Iremosenbici"
          loading="lazy"
          width="600"
          height="600"
        />
        <span class="photo-note">JOSÉ REINA · JEAN SOIRE</span>
      </div>
      <div>
        <span class="eyebrow">UN SUEÑO SOBRE DOS RUEDAS</span>
        <h2>
          La vida es
          <br />
          <em>para vivirla.</em>
        </h2>
        <p class="lead">
          «El mundo está lleno de cosas por explorar y por conocer. Atrévete a
          vivir tus sueños».
        </p>
        <p>
          Soy José Reina, fundador de Iremosenbici. Este proyecto nace de las
          ganas de viajar en bicicleta, conocer a las personas del camino y
          promover una forma más sencilla de movernos por el mundo.
        </p>
        <p>
          Viajamos con lo necesario, con curiosidad y con tiempo para mirar
          alrededor. Cada encuentro puede ser el principio de una nueva
          historia.
        </p>
        <a class="text-link" href="#hacemos">
          Así entendemos el cicloturismo <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <div id="hacemos" class="wrap pilares">
      {pilares.map((p, i) => (
        <article>
          <span class="pillar-number">0{i + 1}</span>
          <img src={p.imagen} alt="" loading="lazy" width="110" height="110" />
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </article>
      ))}
    </div>
  </section>
  <section id="rutas" class="section viajes-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <span class="eyebrow">EL CAMINO QUE IMAGINAMOS</span>
          <h2>
            Un continente.
            <br />
            <em>Muchos encuentros.</em>
          </h2>
        </div>
        <p>
          Hay viajes que empiezan mucho antes de salir. Este es el proyecto que
          estamos preparando.
        </p>
      </div>
      {viajes.map((v) => (
        <article class="viaje-principal">
          <div class="viaje-title">
            <span class="badge">
              {v.estado === "planificado"
                ? "VIAJE PLANIFICADO"
                : v.estado === "completado"
                  ? "VIAJE COMPLETADO"
                  : "VIAJE EN CURSO"}
            </span>
            <h3>
              <a href={`/viajes/${v.slug}`}>{v.titulo}</a>
            </h3>
            <p>{v.resumen}</p>
          </div>
          {v.id === "venezuela-costa-rica" && (
            <ol class="paises-itinerario">
              {paisesPlanificados.map((p, i) => (
                <li>
                  <span class="pais-numero">0{i + 1}</span>
                  <img
                    src={p.imagen}
                    alt=""
                    loading="lazy"
                    width="160"
                    height="120"
                  />
                  <h4>{p.nombre}</h4>
                  <p>{p.texto}</p>
                </li>
              ))}
            </ol>
          )}
          <div class="viaje-bottom">
            <p>
              {v.estado === "planificado"
                ? "El itinerario es orientativo y puede cambiar."
                : "Cada etapa publicada cuenta una parte del viaje."}
            </p>
            <a class="btn btn-yellow" href={`/viajes/${v.slug}`}>
              Explorar el viaje ↗
            </a>
          </div>
        </article>
      ))}
      {!viajes.length && (
        <p>Pronto compartiré los próximos proyectos de viaje.</p>
      )}
    </div>
  </section>
  <section class="section mapa-home">
    <div class="wrap">
      <Map />
    </div>
  </section>
  <section id="galeria" class="section galeria-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <span class="eyebrow">MIRAR. DETENERSE. RECORDAR.</span>
          <h2>
            Postales
            <br />
            <em>del camino.</em>
          </h2>
        </div>
        <p>
          Un espacio para los paisajes, las personas y esos pequeños momentos
          que hacen grande un viaje.
        </p>
      </div>
      <Gallery fotos={fotos} />
    </div>
  </section>
  <section id="patrocinantes" class="section companeros">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <span class="eyebrow">NINGUNA AVENTURA SE CONSTRUYE A SOLAS</span>
          <h2>
            Gracias por
            <br />
            <em>ser parte.</em>
          </h2>
        </div>
        <p>
          Agradecimientos del proyecto original a quienes apoyaron sus primeros
          pasos.
        </p>
      </div>
      <div class="patrocinantes-grid">
        <details class="tarjeta-patro">
          <summary>
            <img
              src="/img-patro/tarjeta-yacares-frente-330.jpg"
              alt="Playa Yacares"
              loading="lazy"
              width="330"
              height="230"
            />
            <span>
              Playa Yacares <span aria-hidden="true">↻</span>
            </span>
          </summary>
          <div class="patro-detalle">
            <h3>Playa Yacares</h3>
            <p>
              Gracias a Erik Sánchez por creer en el proyecto, por los
              implementos donados y por ayudar a encontrar nuevos apoyos.
            </p>
            <a
              href="https://www.instagram.com/eriksanchezphoto/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Conoce su trabajo ↗
            </a>
          </div>
        </details>
        <details class="tarjeta-patro">
          <summary>
            <img
              src="/img-patro/tarjeta-lumig-frente-330.jpg"
              alt="La Bici, bicicletas Lumig"
              loading="lazy"
              width="330"
              height="230"
            />
            <span>
              La Bici · Lumig <span aria-hidden="true">↻</span>
            </span>
          </summary>
          <div class="patro-detalle">
            <h3>La Bici · Lumig</h3>
            <p>
              Gracias a Lucho Migneco por su confianza desde el comienzo y por
              las piezas y partes donadas para el proyecto.
            </p>
            <a
              href="https://www.instagram.com/bicicletaslumig/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Conoce la marca ↗
            </a>
          </div>
        </details>
        <div class="nuevo-companero">
          <span aria-hidden="true">↗</span>
          <h3>
            Tu apoyo también
            <br />
            puede hacer camino.
          </h3>
          <p>
            Ideas, conocimientos, equipamiento o una colaboración. Cada ayuda
            cuenta.
          </p>
          <a class="text-link" href="#contact">
            Conversemos ↗
          </a>
        </div>
      </div>
      <p class="inspiracion">
        También, gracias a{" "}
        <a
          href="https://www.instagram.com/tabarealonso/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Tabaré Alonso
        </a>{" "}
        por inspirar este sueño de recorrer América en bicicleta.
      </p>
    </div>
  </section>
  <section id="donaciones" class="apoyo-section">
    <div class="wrap apoyo-grid">
      <Logo clase="logo-apoyo" />
      <div>
        <span class="eyebrow">PEQUEÑOS GESTOS, GRANDES CAMINOS</span>
        <h2>
          Ayuda a que
          <br />
          el viaje continúe.
        </h2>
        <p>
          Una conversación, una reparación, un consejo o una aportación: toda
          ayuda se recibe con gratitud.
        </p>
        <div class="button-row">
          {sitio.apoyos.map((a) => (
            <a
              class="btn btn-dark"
              href={a.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {a.nombre} ↗
            </a>
          ))}
          <a class="text-link" href="#contact">
            Otras formas de colaborar ↗
          </a>
        </div>
      </div>
    </div>
  </section>
  <Contact />
</Layout>
