---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import Gallery from "../components/Gallery.astro";
import Contact from "../components/Contact.astro";
import Perfiles from "../components/classic/Perfiles.astro";
import Patrocinantes from "../components/classic/Patrocinantes.astro";
import Donaciones from "../components/classic/Donaciones.astro";
import ArchivoInstagram from "../components/classic/ArchivoInstagram.astro";
import { pilaresOriginales, paisesOriginales } from "../data/clasico";
import { entorno } from "../server/env";
import { viajesPublicos, fotosPublicas } from "../server/data";
const [viajes, fotos] = await Promise.all([
  viajesPublicos(entorno),
  fotosPublicas(entorno),
]);
---

<Layout portada>
  <div class="classic">
    <section id="main-header" class="classic-hero">
      <div class="hero-sombra">
        <div class="classic-container classic-banner">
          <h1>Experimenta la libertad</h1>
          <p>...Atrévete y sal de la rutina...</p>
          <p>Comunidad de Cicloturistas</p>
          <a class="classic-bajar" href="#quienes" aria-label="¿Quienes Somos?">
            <i class="fa fa-angle-down" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>
    <Perfiles />
    <section id="hacemos" class="classic-section classic-hacemos">
      <div class="classic-container">
        <h2 class="classic-title">Cicloturismo</h2>
        <hr class="classic-line" />
        <div class="classic-pilares">
          {pilaresOriginales.map((p) => (
            <article>
              <img
                src={p.imagen}
                alt=""
                loading="lazy"
                width="128"
                height="128"
              />
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section id="rutas" class="classic-rutas">
      <div class="rutas-sombra classic-section">
        <div class="classic-container">
          <h2 class="classic-title titulo-ruta">
            Ruta Venezuela &gt; Costa Rica
          </h2>
          <hr class="classic-line" />
          <div class="classic-logo-ruta">
            <Logo />
          </div>
          <div class="classic-paises">
            {paisesOriginales.map((p) => (
              <article>
                <img
                  src={p.imagen}
                  alt=""
                  loading="lazy"
                  width="100"
                  height="120"
                />
                <h3>
                  <span>{p.nombre[0]}</span>
                  {p.nombre.slice(1)}
                </h3>
                <p>{p.texto}</p>
              </article>
            ))}
          </div>
          <p class="classic-ruta-enlace">
            <a href="/viajes/venezuela-costa-rica">
              Sigue acá la Ruta en detalle...
            </a>
          </p>
          {viajes
            .filter((v) => v.id !== "venezuela-costa-rica")
            .map((v) => (
              <p class="classic-ruta-enlace">
                <a href={`/viajes/${v.slug}`}>{v.titulo}</a>
              </p>
            ))}
        </div>
      </div>
    </section>
    <section id="galeria" class="classic-section classic-galeria">
      <div class="classic-container">
        <h2 class="classic-title">Galería</h2>
        {fotos.length ? <Gallery fotos={fotos} /> : <ArchivoInstagram />}
      </div>
    </section>
    <Patrocinantes />
    <Donaciones />
    <Contact />
  </div>
</Layout>
