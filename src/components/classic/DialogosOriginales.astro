<Dialogo id="cicloturista1" titulo="José Reina">
  <div class="modal-body">
    <div class="fondoiremosdiagonal">
      <div class="container-fluid">
        <div class="row">
          <div class="col-xs-5">
            <img
              alt="José Reina"
              class="img-responsive"
              loading="lazy"
              src="/img-perfiles/jose-reina-perfil.jpg"
            />
            <h6>Para contacto directo sigueme:</h6>
            <i
              aria-hidden="true"
              class="fa fa-instagram fa-fw pull-left fa-lg"
            ></i>
            <h5>
              <a
                href="https://www.instagram.com/jhoseph_q/"
                rel="noopener noreferrer"
                target="_blank"
              >
                @jhoseph_q
              </a>
            </h5>
            <div class="flip-g flip-g-text-face">
              <i
                aria-hidden="true"
                class="fa fa-facebook-square fa-fw pull-left fa-lg"
              ></i>
              <h5>
                <a
                  href="https://www.facebook.com/jose.reina.5249?ref=bookmarks"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  Jose Reina
                </a>
              </h5>
            </div>
          </div>
          <div class="col-xs-7 padding-right-zero padding-left-zero">
            <h5>Algo sobre mi:</h5>
            Minimalista <i aria-hidden="true" class="fa fa-compress fa-1x"></i>,
            Idealista <i aria-hidden="true" class="fa fa-lightbulb-o fa-1x"></i>
            , Lector <i aria-hidden="true" class="fa fa-book fa-1x"></i>,
            Dibujante <i aria-hidden="true" class="fa fa-edit fa-1x"></i>,
            Emprendedor <i aria-hidden="true" class="fa fa-user fa-1x"></i>,
            Ciclista <i aria-hidden="true" class="fa fa-bicycle fa-1x"></i>,
            私は日本語のがくせいです
            <i aria-hidden="true" class="fa fa-circle fa-1x"></i>
            <br />
            (Estudiante de Japonés) e Intento de Músico...
            <i aria-hidden="true" class="fa fa-music fa-1x"></i>
            <i aria-hidden="true" class="fa fa-smile-o fa-spin fa-1x"></i>
            <br />
            <h5>Gustos:</h5>
            Películas <i aria-hidden="true" class="fa fa-film fa-1x"></i>, Video
            Juegos <i aria-hidden="true" class="fa fa-gamepad fa-1x"></i>,
            Ajedrez <i aria-hidden="true" class="fa fa-trophy fa-1x"></i>,
            Comida <i aria-hidden="true" class="fa fa-cutlery fa-1x"></i>,
            Conocer <i aria-hidden="true" class="fa fa-map-o fa-1x"></i>,
            Fotografía <i aria-hidden="true" class="fa fa-camera fa-1x"></i>
            <br />
            <h5>De Carrera:</h5>
            Informático y Desarrollador de Software{" "}
            <i aria-hidden="true" class="fa fa-desktop fa-1x"></i>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-footer">
    <div class="col-md-12">
      <h4>Estoy cumpliendo un sueño... Viajar en bicicleta y conocer</h4>
    </div>
  </div>
</Dialogo>
