---
interface Props {
  viaje?: string;
  compacto?: boolean;
  automatico?: boolean;
}
const { viaje = "", compacto = false, automatico = false } = Astro.props;
---

<section
  class="map-widget map-shell"
  data-viaje={viaje}
  data-automatico={automatico ? "true" : undefined}
  aria-label="Mapa de rutas y fotografías"
>
  <div class="map-invitacion map-intro">
    {!compacto && <span>Rutas · Fotografías · 360°</span>}
    <button class="btn btn-dark abrir-mapa" type="button">
      Abrir mapa <span aria-hidden="true">↗</span>
    </button>
  </div>
  <button type="button" class="centrar-mapa" hidden>
    Ver todo el recorrido
  </button>
  <div
    class="map-canvas"
    hidden={!automatico}
    aria-label="Mapa interactivo de rutas y fotografías"
  ></div>
  <p class="map-status" role="status"></p>
  <noscript>
    <p>Activa JavaScript para explorar el mapa.</p>
  </noscript>
</section>
<script>
  import { iniciarMapas } from "../scripts/maps";
  iniciarMapas();
</script>
