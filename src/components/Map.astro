---
import { mapasPersonales } from "../lib/maps";
interface Props {
  compacto?: boolean;
}
const { compacto = false } = Astro.props;
const mapa = compacto ? mapasPersonales.ubicacion : mapasPersonales.recorrido;
const titulo = compacto ? "Mapa de ubicación" : "Mapa de rutas y fotografías";
---

<section class="map-widget map-shell" aria-label={titulo}>
  {!compacto && (
    <div class="map-invitacion map-intro">
      <a class="centrar-mapa" href={mapa.ver} target="_blank" rel="noopener">
        Ver Ruta
      </a>
    </div>
  )}
  <iframe
    class="map-canvas map-google-personal"
    src={mapa.insertar}
    title={titulo}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</section>
