---
import { ciclistas, sitio } from "../data/site";
---

<footer id="footer" class="site-footer">
  <div class="wrap footer-intro">
    <p>
      Un mundo por conocer.
      <br />
      <strong>Una bicicleta para empezar.</strong>
    </p>
    <a class="text-link" href="/#rutas">
      Nos vemos en el camino <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="ciclistas" aria-hidden="true" data-animacion>
    {ciclistas.map((nombre, i) => (
      <span
        class="ciclista-carril"
        style={`--duracion:${26 + i * 2}s;--demora:-${i * 3}s;--alto:${42 + (i % 5) * 7}px`}
      >
        <img src={`/img-ciclistas/${nombre}.png`} alt="" loading="lazy" />
      </span>
    ))}
  </div>
  <div class="wrap footer-bottom">
    <a href="/" class="wordmark">
      <span>IREMOS</span>ENBICI
    </a>
    <p>Diseñado por Jean Soire · {new Date().getFullYear()}</p>
    <nav aria-label="Enlaces del pie">
      <a href={sitio.instagram} target="_blank" rel="noopener noreferrer">
        Instagram ↗
      </a>
      <a href="/privacidad">Privacidad</a>
      <a href="/admin">Mi panel</a>
    </nav>
  </div>
</footer>
